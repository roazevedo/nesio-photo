<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Nésio Photo — Há mais de 15 anos criando imagens que contam histórias" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0c0a08">
    <meta name="description" content="Nésio Photo — fotografia e videografia em Nova Iguaçu, RJ. 15 anos, casamentos e festas infantis. Há mais de 15 anos criando imagens que contam histórias.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:title" content="Nésio Photo — imagens que contam histórias">
    <meta property="og:description" content="15 anos, casamentos e festas infantis em Nova Iguaçu, RJ. Há mais de 15 anos.">
    <meta property="og:image" content="<%= image_url('fotos/casamentos/casamento-01.jpg') rescue '' %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,500..900&family=JetBrains+Mono:wght@400;500;700&display=swap">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
